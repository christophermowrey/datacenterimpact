# Optional MapLibre style URL for the production map adapter.
NEXT_PUBLIC_MAP_STYLE_URL=
# Set true for local-only OSM fallback when no hosted style is configured.
NEXT_PUBLIC_USE_OSM_FALLBACK=true
# Retained OSM fallback path; do not use the public OSM tile service for live traffic.
NEXT_PUBLIC_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Required by Docker Compose. Use a unique value in every environment.
POSTGRES_PASSWORD=
# Set true only after the privacy page, retention, access, and deletion controls are ready.
STORE_SEARCHES=false
# Production host name used by Caddy.
DOMAIN=datacenterimpact.app
# Server-side geocoder credentials are intentionally never exposed to the browser.
GEOCODER_PROVIDER=nominatim
GEOCODER_API_KEY=
# Optional server-side Google Places Autocomplete and place confirmation.
# Leave blank to use the OpenStreetMap/Nominatim fallback locally.
GOOGLE_MAPS_API_KEY=
