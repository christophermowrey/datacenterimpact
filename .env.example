# Optional MapLibre style URL for the production map adapter.
NEXT_PUBLIC_MAP_STYLE_URL=
# Server-side geocoder credentials are intentionally never exposed to the browser.
GEOCODER_PROVIDER=mock
GEOCODER_API_KEY=
# Optional server-side Google Places Autocomplete and place confirmation.
# Leave blank to use the OpenStreetMap/Nominatim fallback locally.
GOOGLE_MAPS_API_KEY=
